# Local only. Never prefix Daraja secrets with VITE_ — that would bundle them into the browser.

# Leave DARAJA_* blank to use the mock STK loop (callback simulated after ~1.8s).
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=

# Force mock even if keys are present (CI / Mini App review).
# VUNA_STK_MOCK=1
# VUNA_STK_MOCK_DELAY_MS=1800

# Friday 18:00 wrap (15:00 UTC). Vercel Cron sends Authorization: Bearer CRON_SECRET.
CRON_SECRET=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Server-only Supabase for wrap recipients (never VITE_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public product config. Anon keys are not Daraja secrets.
# VITE_VUNA_PAYBILL=400200
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
